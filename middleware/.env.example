# Copia a .env y rellena. NUNCA commitees .env (lleva secretos).
PORT=3000

# Bonita (usuario tecnico Orquestador)
BONITA_URL=http://localhost:8080/bonita
BONITA_USER=ofelia.bot
BONITA_PASSWORD=bpm
PROCESS_NAME=GestionPreventa
PROCESS_VERSION=1.0

# HubSpot
HUBSPOT_BASE=https://api.hubapi.com
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_APP_SECRET=
HUBSPOT_PIPELINE=0
STAGE_CLOSED=4
# Las 4 fuentes del Negocio (seccion "Definicion Preventa"), nombres internos reales
ARTEFACTO_PROPS=concepto_viabilidad,valoracion_operaciones,url_ppta_preventa,link_repo_preventa

# Avance automatico "En validacion" -> "Diseno"
MINUTOS_EN_VALIDACION=5
HUBSPOT_STAGE_VALIDACION=2
HUBSPOT_STAGE_DISENO=3

# Opcionales
STORE_PATH=./data/store.json
RECONCILE_MS=86400000
DISENO_CHECK_MS=30000
ARTEFACTOS_CHECK_MS=60000
