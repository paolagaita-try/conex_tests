<?xml version="1.0" encoding="UTF-8"?>
<definition:ConnectorDefinition xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:definition="http://www.bonitasoft.org/ns/connector/definition/6.1">
  <id>correo-tarea-asignada</id>
  <version>1.0.0</version>
  <!-- Servidor SMTP: parámetros de proceso por entorno (param_smtpHost, param_smtpPuerto, param_smtpStarttls,
       param_smtpUsuario, param_smtpContrasena, param_smtpRemitenteNombre). La contraseña nunca va en el repo: el
       parámetro lleva el marcador «sin-configurar» y el conector usa entonces la variable de entorno
       PREVENTA_SMTP_CONTRASENA del servidor. -->
  <input name="host" type="java.lang.String" mandatory="true"/>
  <input name="puerto" type="java.lang.Integer" mandatory="true"/>
  <input name="starttls" type="java.lang.Boolean" mandatory="false"/>
  <input name="usuario" type="java.lang.String" mandatory="true"/>
  <input name="contrasena" type="java.lang.String" mandatory="false"/>
  <input name="remitenteNombre" type="java.lang.String" mandatory="false"/>
  <!-- Mensaje: destinataria, saludo, tarea, enlace y datos del ticket del caso. -->
  <input name="para" type="java.lang.String" mandatory="true"/>
  <input name="nombre" type="java.lang.String" mandatory="false"/>
  <input name="tarea" type="java.lang.String" mandatory="true"/>
  <input name="enlace" type="java.lang.String" mandatory="true"/>
  <input name="ticketId" type="java.lang.String" mandatory="true"/>
  <input name="ticketAsunto" type="java.lang.String" mandatory="false"/>
  <input name="dealId" type="java.lang.String" mandatory="false"/>
  <!-- HubSpot (solo lectura, prioridad del ticket y nombre del Negocio para la ficha del correo). -->
  <input name="urlBase" type="java.lang.String" mandatory="false"/>
  <input name="rutaTickets" type="java.lang.String" mandatory="false"/>
</definition:ConnectorDefinition>
