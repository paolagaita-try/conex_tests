              <parameters xmi:type="connectorconfiguration:ConnectorParameter" xmi:id="_h90f399c40145" key="cuerpo">
                <expression xmi:type="expression:Expression" xmi:id="_h90f399c40146" name="cuerpo_conn_hubspotNota()" content="def esc = { String x -&gt; (x ?: &quot;&quot;).replace(&quot;&amp;&quot;,&quot;&amp;amp;&quot;).replace(&quot;&lt;&quot;,&quot;&amp;lt;&quot;).replace(&quot;&gt;&quot;,&quot;&amp;gt;&quot;).replace(String.valueOf((char) 10), &quot;&lt;&quot; + &quot;br&gt;&quot;) }; def r = [viable: &quot;Viable&quot;, bloqueado: &quot;Bloqueado (falta información del lead)&quot;, no_viable: &quot;No viable&quot;][preventa.resultadoValidacion] ?: preventa.resultadoValidacion; def partes = []; if (preventa.resultadoValidacion == &quot;no_viable&quot;) partes &lt;&lt; &quot;&lt;p&gt;&lt;strong&gt;Cerrado por viabilidad:&lt;/strong&gt; &quot; + esc(preventa.conceptoViabilidad) + &quot;&lt;/p&gt;&quot;; partes &lt;&lt; &quot;&lt;p&gt;&lt;strong&gt;Validación de preventa (Bonita):&lt;/strong&gt; &quot; + esc(r) + &quot;&lt;/p&gt;&quot;; if (preventa.conceptoViabilidad?.trim()) partes &lt;&lt; &quot;&lt;p&gt;&lt;strong&gt;Concepto de viabilidad:&lt;/strong&gt; &quot; + esc(preventa.conceptoViabilidad) + &quot;&lt;/p&gt;&quot;; partes &lt;&lt; &quot;&lt;p&gt;&quot; + esc(preventa.notaValidacion) + &quot;&lt;/p&gt;&quot;; if (preventa.supuestos?.trim()) partes &lt;&lt; &quot;&lt;p&gt;&lt;strong&gt;&quot; + (preventa.conceptoViabilidad == &quot;Aprobado con Condiciones&quot; ? &quot;Condiciones&quot; : &quot;Supuestos&quot;) + &quot;:&lt;/strong&gt; &quot; + esc(preventa.supuestos) + &quot;&lt;/p&gt;&quot;; return partes.join(&quot;&quot;)" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnType="java.lang.String" returnTypeFixed="true">
                  <referencedElements xmi:type="process:BusinessObjectData" xmi:id="_h90f399c40147" name="preventa" dataType="_h90f399c40015" className="co.trycore.preventa.model.Preventa" />
                </expression>
              </parameters>
