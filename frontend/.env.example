# Configuración de los formularios.
#
# Copia este archivo a `.env` y ajústalo. Nada de esto va en el código: `.env` está ignorado por git y sus
# valores son de tu máquina, no del repositorio.

# Dirección del runtime Bonita al que el servidor de desarrollo hace de proxy. El bundle local que levanta
# `tools/run-journey.sh` escucha en 8096 (variable PORT).
BONITA_URL=http://localhost:8096

# Puerto del servidor de desarrollo. La detección de entorno no depende de él.
DEV_PORT=4200

# Formulario que se sirve o construye por defecto.
FORM_ID=_semilla

# Credenciales de DESARROLLO: usuarios ficticios de la organización del proyecto, jamás datos reales. Solo las
# lee el servidor de desarrollo (`npm run dev`, `import.meta.env.DEV`): un build no las incrusta y
# `scripts/build-form.js` falla si la clave aparece en lo construido. En producción la sesión la abre el portal.
VITE_BONITA_DEV_USER=
VITE_BONITA_DEV_PASSWORD=
