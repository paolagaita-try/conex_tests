{
  "name": "hubspot-bonita-formularios",
  "version": "0.1.0",
  "description": "Formularios Svelte del proyecto: un paquete con una entrada de build por formulario, desplegada como página de Bonita",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build:form": "node scripts/build-form.js",
    "build:all": "node scripts/build-form.js --all",
    "check": "svelte-check --tsconfig ./tsconfig.app.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "svelte": "^5.43.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@tsconfig/svelte": "^5.0.6",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^3.2.0",
    "archiver": "^7.0.1",
    "axe-core": "^4.10.2",
    "bootstrap": "3.4.1",
    "fs-extra": "^11.2.0",
    "glob": "^11.1.0",
    "jsdom": "^26.0.0",
    "msw": "^2.8.4",
    "svelte-check": "^4.3.4",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^3.2.0"
  }
}
