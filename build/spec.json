          "tipo": "propio"
        },
        {
          "definicion": "hubspot-ticket-actualizar",
          "entradas": {
            "ownerId": "if (!preventa.consultorOwnerId?.trim()) throw new RuntimeException(\"el caso no tiene consultor asignado\"); return preventa.consultorOwnerId",
            "rutaTickets": "return param_hubspotRutaTickets",
            "stageId": "return param_stageEnValidacion",
            "ticketId": "return preventa.ticketId",
            "urlBase": "return param_hubspotUrlBase"
          },
          "id": "conn_hubspotActualizar",
          "ignorar_errores": false,
          "momento": "entrada",
          "orden": 1,
