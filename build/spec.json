          "entradas": {
            "ownerIds": "def owners = []; param_consultores.replaceAll(\"\\\\s\",\"\").split(\";\").findAll{it}.each{ p -> def kv = p.split(\":\",2); if (kv.length != 2) throw new RuntimeException(\"param_consultores mal formado\"); if (kv[0].isEmpty()) throw new RuntimeException(\"param_consultores mal formado\"); if (owners.contains(kv[0])) throw new RuntimeException(\"param_consultores mal formado\"); owners.add(kv[0]) }; return owners.join(\",\")",
            "pipelineId": "return param_pipelineTickets",
            "rutaTickets": "return param_hubspotRutaTickets",
            "stages": "return param_stageEnValidacion + \",\" + param_stageEnDiseno",
            "ultimoOwnerId": "def r = preventaDAO.findAsignadasRecientes(0, 1); return (!r) ? \"\" : (r[0].consultorOwnerId ?: \"\")",
            "urlBase": "return param_hubspotUrlBase"
          },
          "id": "conn_hubspotCarga",
          "ignorar_errores": false,
          "momento": "entrada",
          "orden": 1,
