      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"200 (la semilla se aplicó en la primera invocación)\", () => pm.response.to.have.status(200));",
              "const v = pm.response.json();",
              "pm.test(\"la lista saludos\", () => { pm.expect(v.definicion).to.eql(\"saludos\"); pm.expect(v.clase).to.eql(\"LISTA\"); });",
              "pm.test(\"las opciones de la semilla, en su orden\", () => pm.expect(v.opciones.map((o) => o.etiqueta)).to.eql([\"Hola\", \"Buenos días\", \"Bienvenida\"]));",
              "pm.test(\"códigos del módulo\", () => pm.expect(v.opciones.map((o) => o.codigo)).to.eql([\"hola\", \"buenos_dias\", \"bienvenida\"]));"
            ]
          }
        }
      ]
