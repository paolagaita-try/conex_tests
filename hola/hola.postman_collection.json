    {
      "name": "2. proceso Hola instalado y habilitado",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Bonita-API-Token",
            "value": "{{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/API/bpm/process?f=name=Hola&f=version={{versionProceso}}&p=0&c=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "API",
            "bpm",
            "process"
          ],
          "query": [
            {
              "key": "f",
              "value": "name=Hola"
            },
            {
              "key": "f",
              "value": "version={{versionProceso}}"
            },
            {
              "key": "p",
              "value": "0"
            },
            {
              "key": "c",
              "value": "10"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const p = pm.response.json();",
              "pm.test(\"el archive no se instaló: no hay proceso Hola\", () => pm.expect(p.length).to.eql(1));",
              "pm.test(\"versión esperada\", () => pm.expect(p[0].version).to.eql(pm.variables.get(\"versionProceso\") || \"1.0\"));",
              "pm.test(\"habilitado\", () => pm.expect(p[0].activationState).to.eql(\"ENABLED\"));",
              "pm.collectionVariables.set(\"processId\", p[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2b. form mapping de la tarea: URL a su página en la app hola",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Bonita-API-Token",
            "value": "{{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/API/form/mapping?f=processDefinitionId={{processId}}&f=type=TASK&p=0&c=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "API",
            "form",
            "mapping"
          ],
          "query": [
            {
              "key": "f",
              "value": "processDefinitionId={{processId}}"
            },
            {
              "key": "f",
              "value": "type=TASK"
            },
            {
              "key": "p",
              "value": "0"
            },
            {
              "key": "c",
              "value": "10"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"200\", () => pm.response.to.have.status(200));",
              "const m = pm.response.json();",
              "pm.test(\"un form mapping de tarea, el de Revisión\", () => { pm.expect(m.length).to.eql(1); pm.expect(m[0].task).to.eql(pm.variables.get(\"nombreTarea\") || \"Revisión\"); });",
              "pm.test(\"por URL\", () => pm.expect(m[0].target).to.eql(\"URL\"));",
              "pm.test(\"a la página del formulario Svelte\", () => pm.expect(m[0].url).to.eql(\"/bonita/portal/resource/app/hola/frmHolaRevisar/content/\"));"
            ]
          }
        }
      ]
