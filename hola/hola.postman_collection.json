    {
      "name": "4. tarea humana Revisión",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Bonita-API-Token",
            "value": "{{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/API/bpm/humanTask?f=caseId={{caseId}}&p=0&c=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "API",
            "bpm",
            "humanTask"
          ],
          "query": [
            {
              "key": "f",
              "value": "caseId={{caseId}}"
            },
            {
              "key": "p",
              "value": "0"
            },
            {
              "key": "c",
              "value": "10"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const t = pm.response.json();",
              "const n = Number(pm.collectionVariables.get(\"intentos\")) + 1;",
              "pm.collectionVariables.set(\"intentos\", n);",
              "if (t.length === 0 && n < 30) { setTimeout(() => {}, 2000); postman.setNextRequest(\"4. tarea humana Revisión\"); return; }",
              "pm.test(\"hay una tarea\", () => pm.expect(t.length).to.eql(1));",
              "pm.test(\"se llama como en el spec\", () => pm.expect(t[0].displayName || t[0].name).to.eql(pm.variables.get(\"nombreTarea\") || \"Revisión\"));",
              "pm.collectionVariables.set(\"taskId\", t[0].id);"
            ]
          }
        }
      ]
    },
