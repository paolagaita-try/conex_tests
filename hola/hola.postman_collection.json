              "key": "username",
              "value": "{{adminUsuario}}"
            },
            {
              "key": "password",
              "value": "{{adminClave}}"
            },
            {
              "key": "redirect",
              "value": "false"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"login 204\", () => pm.response.to.have.status(204));",
              "pm.collectionVariables.set(\"token\", pm.cookies.get(\"X-Bonita-API-Token\"));"
            ]
          }
